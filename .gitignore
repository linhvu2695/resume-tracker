__pycache__/
*.pyc
.venv/
node_modules/
server.log
*.tmp
.DS_Store
.claude/
.pytest_cache/

# Personal data never enters git -- not even a private remote. Resume PDFs carry a
# name, phone, email and address; git history keeps them forever. Code goes to the
# remote; applications/ stays on this machine (back it up separately). README -> Privacy.
applications/*
!applications/.gitkeep
state.json
resumes/
*.pdf
