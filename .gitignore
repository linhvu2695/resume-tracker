__pycache__/
*.pyc
.venv/
node_modules/
server.log
*.tmp
.DS_Store
# The /tailor skill is part of the app; local Claude settings are not.
.claude/*
!.claude/skills/
.pytest_cache/

# Personal data never enters git -- the repo is public. Resume PDFs carry a
# name, phone, email and address; git history keeps them forever. Code goes to the
# remote; applications/ stays on this machine (back it up separately). README -> Privacy.
applications/*
!applications/.gitkeep
state.json
resumes/
*.pdf

# Demo build: personal inputs (resume, tailored versions) and the built site stay out of git.
demo/private/
demo/dist/
